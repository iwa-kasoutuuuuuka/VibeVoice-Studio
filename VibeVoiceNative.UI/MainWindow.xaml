<Window
    x:Class="VibeVoiceNative.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VibeVoiceNative.UI"
    xmlns:models="using:VibeVoiceNative.UI.Models"
    xmlns:ski="using:SkiaSharp.Views.Windows"
    Title="VibeVoice Studio Ultimate">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Padding="15">
            <StackPanel Spacing="12">
                <TextBlock Text="VibeVoice Ultimate" FontSize="20" FontWeight="Bold"/>
                
                <TextBlock x:Uid="LanguageSettingsHeader" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="日本語 / JP" Command="{x:Bind ViewModel.SetLanguageCommand}" CommandParameter="JP" HorizontalAlignment="Stretch" Width="145"/>
                    <Button Content="English / EN" Command="{x:Bind ViewModel.SetLanguageCommand}" CommandParameter="EN" HorizontalAlignment="Stretch" Width="145"/>
                </StackPanel>

                <TextBlock x:Uid="ApiServerHeader" FontWeight="SemiBold"/>
                <Button x:Uid="ToggleApiButton" Command="{x:Bind ViewModel.ToggleApiServerCommand}" HorizontalAlignment="Stretch"/>
                
                <TextBlock x:Uid="PerformanceHeader" FontWeight="SemiBold"/>
                <StackPanel Spacing="5">
                    <TextBlock x:Uid="InferenceStepsLabel" FontSize="12"/>
                    <Slider Value="{x:Bind ViewModel.InferenceSteps, Mode=TwoWay}" Minimum="4" Maximum="50"/>
                    <TextBlock x:Uid="SpeedLabel" FontSize="12"/>
                    <Slider Value="{x:Bind ViewModel.Speed, Mode=TwoWay}" Minimum="0.5" Maximum="2.0" StepFrequency="0.1"/>
                    <TextBlock x:Uid="PitchLabel" FontSize="12"/>
                    <Slider Value="{x:Bind ViewModel.Pitch, Mode=TwoWay}" Minimum="-500" Maximum="500" StepFrequency="10"/>
                </StackPanel>

                <TextBlock x:Uid="DeviceHeader" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.InferenceDevices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <Button x:Uid="InitEngineButton" Command="{x:Bind ViewModel.InitializeEngineCommand}" HorizontalAlignment="Stretch"/>

                <TextBlock x:Uid="VoiceGalleryHeader" FontWeight="SemiBold"/>
                <StackPanel Spacing="5">
                    <TextBlock x:Uid="RefAudioLabel" FontSize="12"/>
                    <Grid ColumnSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{x:Bind ViewModel.RefAudioPath, Mode=TwoWay}" FontSize="12"/>
                        <Button Grid.Column="1" x:Uid="PickFileButton" Command="{x:Bind ViewModel.PickRefAudioFileCommand}"/>
                    </Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.VoiceGallery}" SelectedItem="{x:Bind ViewModel.SelectedVoice, Mode=TwoWay}" MaxHeight="120" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VoiceModel">
                                <TextBlock Text="{x:Bind Name}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock x:Uid="UserDictHeader" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.UserDictionary}" MaxHeight="80">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserDictionaryEntry">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{x:Bind OriginalText, Mode=TwoWay}" PlaceholderText="単語 / Word" Width="140"/>
                                <TextBox Text="{x:Bind Reading, Mode=TwoWay}" PlaceholderText="読み / Reading" Width="140"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Uid="AddWordButton" Command="{x:Bind ViewModel.AddUserDictCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox x:Uid="InputTextHeader" Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" />
            
            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="Bold"/>
                <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Margin="0,5"/>
                <ski:SKXamlCanvas x:Name="WaveformCanvas" Height="100" PaintSurface="OnPaintSurface" Background="Black"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Uid="BatchExportButton" Command="{x:Bind ViewModel.BatchExportCommand}" IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Uid="StopButton" Command="{x:Bind ViewModel.StopCommand}"/>
                <Button x:Uid="GenerateButton" Command="{x:Bind ViewModel.GenerateAudioCommand}" IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}" Width="150"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

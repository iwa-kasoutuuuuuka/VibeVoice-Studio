<Window
    x:Class="VibeVoiceNative.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VibeVoiceNative.UI"
    xmlns:models="using:VibeVoiceNative.UI.Models"
    xmlns:ski="using:SkiaSharp.Views.Windows"
    Title="VibeVoice Studio Ultimate (日本語 / English)">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Padding="15">
            <StackPanel Spacing="12">
                <TextBlock Text="VibeVoice Ultimate" FontSize="20" FontWeight="Bold"/>
                
                <TextBlock Text="言語設定 / Language" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="日本語 / JP" Command="{x:Bind ViewModel.SetLanguageCommand}" CommandParameter="JP" HorizontalAlignment="Stretch" Width="145"/>
                    <Button Content="English / EN" Command="{x:Bind ViewModel.SetLanguageCommand}" CommandParameter="EN" HorizontalAlignment="Stretch" Width="145"/>
                </StackPanel>

                <TextBlock Text="API サーバー / API Server" FontWeight="SemiBold"/>
                <Button Content="起動・停止 / Start or Stop API" Command="{x:Bind ViewModel.ToggleApiServerCommand}" HorizontalAlignment="Stretch"/>
                
                <TextBlock Text="推論設定 / Performance" FontWeight="SemiBold"/>
                <StackPanel Spacing="2">
                    <TextBlock Text="推論ステップ数 / Inference Steps" FontSize="12"/>
                    <Slider Value="{x:Bind ViewModel.InferenceSteps, Mode=TwoWay}" Minimum="4" Maximum="50"/>
                </StackPanel>

                <TextBlock Text="デバイス選択 / Device" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{x:Bind ViewModel.InferenceDevices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <Button Content="エンジン初期化 / Initialize Engine" Command="{x:Bind ViewModel.InitializeEngineCommand}" HorizontalAlignment="Stretch"/>

                <TextBlock Text="ユーザー辞書 / User Dictionary" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind ViewModel.UserDictionary}" MaxHeight="80">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserDictionaryEntry">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{x:Bind OriginalText, Mode=TwoWay}" PlaceholderText="単語 / Word" Width="140"/>
                                <TextBox Text="{x:Bind Reading, Mode=TwoWay}" PlaceholderText="読み / Reading" Width="140"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="単語追加 / Add Word" Command="{x:Bind ViewModel.AddUserDictCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" 
                     PlaceholderText="台本を入力してください / Enter your script... [Speaker] Hello!"/>
            
            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="Bold"/>
                <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Margin="0,5"/>
                <ski:SKXamlCanvas x:Name="WaveformCanvas" Height="100" PaintSurface="OnPaintSurface" Background="Black"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="一括書き出し / Batch Script" Command="{x:Bind ViewModel.BatchExportCommand}" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="停止 / Stop" Command="{x:Bind ViewModel.StopCommand}"/>
                <Button Content="音声生成 / Generate" Command="{x:Bind ViewModel.GenerateAudioCommand}" Width="150"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

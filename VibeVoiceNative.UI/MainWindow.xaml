<Window
    x:Class="VibeVoiceNative.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VibeVoiceNative.UI"
    xmlns:models="using:VibeVoiceNative.UI.Models"
    xmlns:ski="using:SkiaSharp.Views.Windows"
    Title="VibeVoice Studio Ultimate">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Padding="15">
            <StackPanel Spacing="12">
                <TextBlock Text="VibeVoice Ultimate" FontSize="20" FontWeight="Bold"/>
                
                <TextBlock Text="API Server" FontWeight="SemiBold"/>
                <Button Content="Start/Stop API" Command="{Binding ViewModel.ToggleApiServerCommand}" HorizontalAlignment="Stretch"/>
                
                <TextBlock Text="Performance" FontWeight="SemiBold"/>
                <Slider Value="{Binding ViewModel.InferenceSteps, Mode=TwoWay}" Minimum="4" Maximum="50"/>

                <TextBlock Text="Device" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ViewModel.InferenceDevices}" SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <Button Content="Initialize" Command="{Binding ViewModel.InitializeEngineCommand}" HorizontalAlignment="Stretch"/>

                <TextBlock Text="User Dict" FontWeight="SemiBold"/>
                <ListView ItemsSource="{Binding ViewModel.UserDictionary}" MaxHeight="80">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding OriginalText, Mode=TwoWay}" Width="80"/>
                                <TextBox Text="{Binding Reading, Mode=TwoWay}" Width="80"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Add Word" Command="{Binding ViewModel.AddUserDictCommand}" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox Text="{Binding ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="16" 
                     PlaceholderText="[Speaker] Hello!"/>
            
            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock Text="{Binding ViewModel.StatusMessage}"/>
                <ProgressBar Value="{Binding ViewModel.Progress}" Margin="0,5"/>
                <ski:SKXamlCanvas x:Name="WaveformCanvas" Height="100" PaintSurface="OnPaintSurface" Background="Black"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Batch Script" Command="{Binding ViewModel.BatchExportCommand}" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Stop" Command="{Binding ViewModel.StopCommand}"/>
                <Button Content="Generate" Command="{Binding ViewModel.GenerateAudioCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

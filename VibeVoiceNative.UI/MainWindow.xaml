<Window
    x:Class="VibeVoiceNative.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VibeVoiceNative.UI"
    xmlns:models="using:VibeVoiceNative.UI.Models"
    xmlns:ski="using:SkiaSharp.Views.Windows"
    Title="VibeVoice Studio Pro">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <ScrollViewer Grid.Column="0" Padding="20">
            <StackPanel Spacing="15">
                <TextBlock Text="VibeVoice Pro" FontSize="24" FontWeight="Bold"/>
                
                <TextBlock Text="Engine Device" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ViewModel.InferenceDevices}" SelectedItem="{Binding ViewModel.SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                <Button Content="Initialize" Command="{Binding ViewModel.InitializeEngineCommand}" HorizontalAlignment="Stretch"/>
                
                <TextBlock Text="Output Device" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding ViewModel.AudioDevices}" SelectedItem="{Binding ViewModel.SelectedAudioDevice, Mode=TwoWay}" DisplayMemberPath="Name" HorizontalAlignment="Stretch"/>

                <TextBlock Text="User Dictionary" FontWeight="SemiBold"/>
                <ListView ItemsSource="{Binding ViewModel.UserDictionary}" MaxHeight="100">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBox Text="{Binding OriginalText, Mode=TwoWay}" Width="100"/>
                                <TextBox Text="{Binding Reading, Mode=TwoWay}" Width="100"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="Add Word" Command="{Binding ViewModel.AddUserDictCommand}" HorizontalAlignment="Stretch"/>

                <TextBlock Text="Voice Gallery" FontWeight="SemiBold"/>
                <ItemsControl ItemsSource="{Binding ViewModel.FilteredVoiceGallery}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" GroupName="VoiceGroup"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Main Content -->
        <Grid Grid.Column="1" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBox Text="{Binding ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"/>
            
            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock Text="{Binding ViewModel.StatusMessage}"/>
                <ProgressBar Value="{Binding ViewModel.Progress}" Margin="0,5"/>
                <ski:SKXamlCanvas x:Name="WaveformCanvas" Height="100" PaintSurface="OnPaintSurface" Background="Black"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Batch Export" Command="{Binding ViewModel.BatchExportCommand}"/>
                <Button Content="Stop" Command="{Binding ViewModel.StopCommand}"/>
                <Button Content="Generate" Style="{StaticResource AccentButtonStyle}" Command="{Binding ViewModel.GenerateAudioCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
